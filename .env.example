# ──────────────────────────────────────────────
# Flex Vue Admin — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and update the values.

# API Base URL for the backend
# When empty, the app uses MockAuthRepository in development mode.
# Set this to your backend URL to use real API calls.
# Example: NUXT_PUBLIC_API_BASE=http://localhost:8000/api
NUXT_PUBLIC_API_BASE=
